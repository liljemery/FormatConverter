{
	"name": "format-converter",
	"version": "2.0.0",
	"type": "module",
	"description": "Lightweight browser-side image format conversion: WebP, PNG, JPEG, AVIF, PDF — with optional resize. Works with any framework.",
	"main": "./src/index.js",
	"types": "./src/.d.ts",
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"demo": "vite --config vite.demo.config.js",
		"build:demo": "vite build --config vite.demo.config.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/liljemery/FormatConverter.git"
	},
	"keywords": [
		"format",
		"converter",
		"webp",
		"png",
		"jpg",
		"jpeg",
		"avif",
		"pdf",
		"resize",
		"canvas",
		"browser"
	],
	"author": {
		"name": "Jeremy Inoa Fortuna",
		"email": "jeremy.inoafort@gmail.com",
		"url": "https://github.com/liljemery"
	},
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/liljemery/FormatConverter/issues"
	},
	"homepage": "https://github.com/liljemery/FormatConverter#readme",
	"devDependencies": {
		"happy-dom": "^17.4.4",
		"vite": "^6.2.2",
		"vitest": "^3.0.9"
	},
	"files": [
		"src"
	]
}
